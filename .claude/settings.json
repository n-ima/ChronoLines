{
  "permissions": {
    "deny": [
      "Edit(.github/agents/**)",
      "Write(.github/agents/**)",
      "Edit(.github/hooks/**)",
      "Write(.github/hooks/**)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(.github/prompts/**)",
      "Write(.github/prompts/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)",
      "Edit(.claude/commands/**)",
      "Write(.claude/commands/**)",
      "Edit(.agents/workflows/**)",
      "Write(.agents/workflows/**)",
      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(plugin.json)",
      "Write(plugin.json)",
      "Edit(.vscode/settings.json)",
      "Write(.vscode/settings.json)",
      "Edit(docs/**/*_template.md)",
      "Write(docs/**/*_template.md)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git push:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-template-edit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-harness-config-edit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-secret-leak.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-phase-scope.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-dangerous-git.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/guard-secret-leak.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/warn-stale-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/check-doc-chars.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/inject-progress.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/inject-progress.sh PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/route-request.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/remind-record.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/log-effort.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/run-python.sh .github/hooks/scripts/log-effort.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
